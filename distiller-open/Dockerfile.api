FROM python:3.11-slim

WORKDIR /app

# Use Aliyun Debian mirror to speed up apt downloads in China
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true

# curl is needed for the docker healthcheck. cryptography ships wheels so no gcc needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY src ./src

# Install in editable mode using a stub README to satisfy setuptools.
# Use Aliyun PyPI mirror for speed inside CN.
RUN echo "# distiller" > README.md && \
    pip install --no-cache-dir \
        -i https://mirrors.aliyun.com/pypi/simple/ \
        --trusted-host mirrors.aliyun.com \
        -e .

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src

EXPOSE 8000

CMD ["uvicorn", "distiller.main:app", "--host", "0.0.0.0", "--port", "8000"]
